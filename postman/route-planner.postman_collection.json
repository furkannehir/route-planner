{
  "info": {
    "name": "Fuel Route Planner API",
    "description": "Coordinate requests use one OpenRouteService directions call. Name requests add geocoding calls. Set ORS_API_KEY in the Django server's ignored .env file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"}
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health/"
      }
    },
    {
      "name": "Short route: Austin to Dallas (one directions call)",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Route returned', () => pm.response.to.have.status(200));",
            "const result = pm.response.json();",
            "pm.test('GeoJSON route returned', () => pm.expect(result.map.type).to.eql('FeatureCollection'));",
            "pm.test('At most one directions call', () => pm.expect(result.provider_requests.directions).to.be.at.most(1));"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": {\"latitude\": 30.2672, \"longitude\": -97.7431},\n  \"finish\": {\"latitude\": 32.7767, \"longitude\": -96.7970},\n  \"starting_fuel_gallons\": 50\n}"
        },
        "url": "{{baseUrl}}/api/v1/routes/"
      }
    },
    {
      "name": "Long route: Dallas to Chicago (fuel stops)",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Long route returned', () => pm.response.to.have.status(200));",
            "const result = pm.response.json();",
            "pm.test('Route is over 500 miles', () => pm.expect(result.route.distance_miles).to.be.above(500));",
            "pm.test('Multiple fuel stops returned', () => pm.expect(result.fuel_stops.length).to.be.at.least(2));",
            "pm.test('Cost and GeoJSON returned', () => { pm.expect(Number(result.fuel.total_cost_usd)).to.be.above(0); pm.expect(result.map.type).to.eql('FeatureCollection'); });",
            "pm.test('At most one directions call', () => pm.expect(result.provider_requests.directions).to.be.at.most(1));"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": {\"latitude\": 32.7767, \"longitude\": -96.7970},\n  \"finish\": {\"latitude\": 41.8781, \"longitude\": -87.6298},\n  \"starting_fuel_gallons\": 50\n}"
        },
        "url": "{{baseUrl}}/api/v1/routes/"
      }
    },
    {
      "name": "Repeat long route: cached directions",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Route returned', () => pm.response.to.have.status(200));",
            "const result = pm.response.json();",
            "pm.test('No new directions call', () => pm.expect(result.provider_requests.directions).to.eql(0));",
            "pm.test('Fuel stops still returned', () => pm.expect(result.fuel_stops.length).to.be.at.least(2));"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": {\"latitude\": 32.7767, \"longitude\": -96.7970},\n  \"finish\": {\"latitude\": 41.8781, \"longitude\": -87.6298},\n  \"starting_fuel_gallons\": 50\n}"
        },
        "url": "{{baseUrl}}/api/v1/routes/"
      }
    },
    {
      "name": "Place names: Dallas to Chicago (two geocodes and one route)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Chicago, IL\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/routes/"
      }
    },
    {
      "name": "Reject a Canadian start",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Outside-US location rejected', () => pm.response.to.have.status(400));"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": {\"latitude\": 43.6532, \"longitude\": -79.3832},\n  \"finish\": {\"latitude\": 32.7767, \"longitude\": -96.7970}\n}"
        },
        "url": "{{baseUrl}}/api/v1/routes/"
      }
    }
  ]
}
